CONFIG_PKG_USING_PAHOMQTT=y
CONFIG_PKG_PAHOMQTT_PATH="/packages/iot/pahomqtt"
CONFIG_PKG_PAHOMQTT_VER="latest"
CONFIG_PAHOMQTT_PIPE_MODE=y
CONFIG_RT_PKG_MQTT_THREAD_STACK_SIZE=4096
CONFIG_PKG_PAHOMQTT_SUBSCRIBE_HANDLERS=1
CONFIG_MQTT_DEBUG=y

CONFIG_PKG_USING_NETUTILS=y
CONFIG_PKG_NETUTILS_PATH="/packages/iot/netutils"
CONFIG_PKG_NETUTILS_VER="latest"
CONFIG_NETUTILS_NTP=y
CONFIG_NETUTILS_NTP_TIMEZONE=8
CONFIG_NETUTILS_NTP_HOSTNAME="cn.ntp.org.cn"
CONFIG_NETUTILS_NTP_HOSTNAME2="ntp.ntsc.ac.cn"
CONFIG_NETUTILS_NTP_HOSTNAME3="edu.ntp.org.cn"
CONFIG_NETUTILS_IPERF=y
CONFIG_NETUTILS_TFTP=y
# end of IoT - internet of things

#
# tools packages
#
CONFIG_PKG_USING_CJSON=y
CONFIG_PKG_CJSON_PATH="/packages/tools/cjson"
CONFIG_PKG_CJSON_VER="latest"
# end of tools packages

# end of PKG config
