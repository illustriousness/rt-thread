/dts-v1/;

/ {
	description = "RK3506 open RT-Thread SMP image";
	#address-cells = <1>;

	images {
		rtthread {
			description = "Open RT-Thread 3-core SMP";
			data = /incbin/("rtthread-smp.bin");
			type = "firmware";
			compression = "none";
			arch = "arm";
			os = "rtos";
			cpu = <0x00000f00>;
			thumb = <0>;
			hyp = <0>;
			load = <0x04000000>;
			entry = <0x04000000>;

			hash {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "conf";

		conf {
			description = "RK3506 f00 RT-Thread SMP";
			loadables = "rtthread";
		};
	};
};
